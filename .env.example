# No secrets are needed. These two are set by the GitHub Pages workflow (.github/workflows/ci.yml)
# and are optional locally.
# Path prefix when served from a sub-path, e.g. /portfolio. Leave empty for <name>.github.io.
NEXT_PUBLIC_BASE_PATH=
# Site origin used in metadata, sitemap and robots. Defaults to https://nakulsethi.github.io.
NEXT_PUBLIC_SITE_ORIGIN=
